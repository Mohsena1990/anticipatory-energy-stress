# UK Data Service Understanding Society (SN 6614) — large, licensed data.
# Not for redistribution: extract locally from your own UKDS-registered
# download, never commit.
data/social_science_data/*.zip
data/raw/ukhls/
outputs/ukhls_cleaned/ukhls_panel.csv
outputs_v2/ukhls_cleaned/ukhls_panel.csv
data/
*.zip
*.csv

# Row-level UKHLS-derived outputs (one row per household/person). UK Data
# Service End User Licence: never commit, even with `git add -f`. Removed
# from all history on 2026-09-26.
outputs*/**/*_scores.csv
outputs*/**/cvae_latent_scores.csv
outputs*/**/cvae_counterfactual_fes_shift.csv
outputs*/**/stage5_transition_pairs.csv
outputs*/**/stage5_forward_predictions.csv
outputs*/ukhls_cleaned/

# ENABLE.EU survey microdata and respondent-level derived outputs (earlier
# project phase). Removed from all history on 2026-09-26; never commit.
data/social_science_data/
outputs*/enable_cleaned/*_scored.csv
outputs*/**/*_predictions.csv
outputs*/**/*_scored.csv

# Bytecode cache for analysis scripts (generated on import)
scripts/__pycache__/

# Thesis asset bundle (local build product; see scripts/build_thesis_assets.py)
outputs_v2/thesis_assets_v2/
outputs_v2/thesis_assets_v2.zip
